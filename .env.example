# Database
DATABASE_URL="postgresql://user:password@host:5432/bookpro?pgbouncer=true"
DIRECT_URL="postgresql://user:password@host:5432/bookpro"

# Auth
JWT_SECRET="your-super-secret-jwt-key-change-this"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Google OAuth
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:4000/calendar/callback"

# Email
RESEND_API_KEY="re_xxxxxxxxxxxx"
RESEND_FROM_EMAIL="info@bookpro.gr"

# App
APP_URL="http://localhost:3000"
API_URL="http://localhost:4000"
PORT=4000
NODE_ENV="development"
